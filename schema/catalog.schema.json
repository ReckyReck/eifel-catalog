{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reckyreck.github.io/eifel-catalog/schema/catalog.schema.json",
  "title": "Eifel Mastering Central - catalog.json (generated, do not edit by hand)",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "plugin": {
      "type": "object",
      "required": ["id", "name", "tagline", "category", "image", "channel", "formats", "bundleNames", "latest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": ["string", "null"], "pattern": "^https://" },
        "channel": { "enum": ["stable", "beta"] },
        "formats": { "type": "object" },
        "bundleNames": { "type": "object" },
        "bundleId": { "type": "string" },
        "latest": {
          "type": "object",
          "required": ["version", "releasedAt", "changelog", "minOS", "assets"],
          "properties": {
            "version": { "$ref": "#/$defs/semver" },
            "releasedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "changelog": { "type": "array", "items": { "type": "string" } },
            "minOS": { "type": "object" },
            "assets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["platform", "arch", "url", "sha256", "size", "contains"],
                "properties": {
                  "platform": { "enum": ["macos", "windows"] },
                  "arch": { "enum": ["universal", "x64", "arm64"] },
                  "url": { "type": "string", "pattern": "^https://github\\.com/ReckyReck/eifel-catalog/releases/download/" },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "size": { "type": "integer", "minimum": 1 },
                  "contains": { "type": "array", "items": { "enum": ["au", "vst3", "clap"] }, "minItems": 1, "uniqueItems": true }
                }
              }
            }
          }
        }
      }
    }
  }
}
